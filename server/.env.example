PUERTO_SERVIDOR=3006
HOST_BD=localhost
PUERTO_BD=3306
USUARIO_BD=root
CONTRASENA_BD=
NOMBRE_BD=ingreso_lira
ORIGENES_CORS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:5173,http://127.0.0.1:5173
# OBLIGATORIO en producción (mínimo 16 caracteres, no usar valores de ejemplo). Genera uno con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
# En desarrollo, si falta, se usa un secreto aleatorio temporal.
JWT_SECRET=
JWT_EXPIRACION=8h
USUARIO_ADMIN_INICIAL=admin
# OBLIGATORIO en producción SOLO la primera vez (cuando aún no existe ningún usuario). Mínimo 8 caracteres.
# En desarrollo, si falta, se genera una aleatoria y se muestra una vez en la consola.
CONTRASENA_ADMIN_INICIAL=

# Configuración de consola UniFi Access (API Developer v1)
UNIFI_HOST=192.168.40.178
UNIFI_PORT=12445
UNIFI_TOKEN=token_unifi
UNIFI_VERIFY_SSL=false
UNIFI_PUERTA_DEFECTO=id_puerta_defecto
UNIFI_PUERTA_PRINCIPAL_ID=id_puerta_principal
UNIFI_PUERTA_PRINCIPAL_NOMBRE=Puerta Ppal LIRA
# IDs de puertas asignadas por defecto al código QR de visitantes (separadas por coma, mínimo 2)
UNIFI_PUERTAS_VISITANTE=id_puerta_principal,id_puerta_interna
UNIFI_VENTANA_SEGUNDOS=3600
UNIFI_MAX_ACCESOS=6
UNIFI_POLL_INTERVAL_MS=5000
UNIFI_TIMEOUT_MS=15000
# Segundos mínimos entre dos lecturas del mismo código QR para evitar que un doble escaneo consuma dos usos
UNIFI_QR_COOLDOWN_SEGUNDOS=30
# SOLO DESARROLLO: si es true y la consola UniFi no responde, se genera un QR FALSO
# que NO abre ninguna puerta (no se envía por correo). Se ignora si NODE_ENV=production.
UNIFI_MODO_PRUEBA=false

# Configuración SMTP opcional para enviar el código QR por correo electrónico
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Lira Seguridad <no-reply@liraseguridad.com>"
